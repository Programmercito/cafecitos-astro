---
// src/components/PlanCard.astro
export interface Props {
  title: string;
  description: string;
  price: string;
  pricePeriod: string;
  features: string[];
  isPrimary?: boolean;
}

const { title, description, price, pricePeriod, features, isPrimary = false } = Astro.props;

---

<article class:list={['plan-card', { 'plan-primary': isPrimary }]}>
    <div class="plan-label">{isPrimary ? 'EN LA NUBE ✳' : 'INSTALACIÓN LOCAL ↗'}</div>
    <h3>{title}</h3>
    <p class="plan-description">{description}</p>
    <p class="plan-price">{price} <span>{pricePeriod}</span></p>
    <ul>
        {features.map(feature => (
            <li><span aria-hidden="true">✳</span> {feature}</li>
        ))}
    </ul>
    <a href="#contact-section" class="plan-link">Conocer más <span aria-hidden="true">↗</span></a>
</article>
