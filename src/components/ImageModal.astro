<dialog id="image-modal" class="image-modal" aria-labelledby="modal-caption">
    <button id="close-modal-btn" type="button" aria-label="Cerrar imagen">×</button>
    <img id="modal-image" alt="" />
    <p id="modal-caption"></p>
</dialog>

<script>
    const modal = document.querySelector<HTMLDialogElement>('#image-modal');
    const image = document.querySelector<HTMLImageElement>('#modal-image');
    const caption = document.querySelector<HTMLElement>('#modal-caption');
    const closeButton = document.querySelector<HTMLButtonElement>('#close-modal-btn');

    if (!modal || !image || !caption || !closeButton) {
        console.error('No se encontraron los elementos del visor de imágenes.');
    } else {
        document.querySelectorAll<HTMLButtonElement>('.feature-image').forEach((button) => {
            button.addEventListener('click', () => {
                const imageUrl = button.dataset.image;
                const imageCaption = button.dataset.caption;
                if (!imageUrl || !imageCaption) {
                    console.error('Faltan datos de la imagen.');
                    return;
                }
                image.src = imageUrl;
                image.alt = imageCaption;
                caption.textContent = imageCaption;
                modal.showModal();
            });
        });
        closeButton.addEventListener('click', () => modal.close());
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && modal.open) modal.close();
        });
        modal.addEventListener('click', (event) => {
            if (event.target === modal) modal.close();
        });
    }
</script>
