---
// src/components/FeatureCard.astro
export interface Props {
  title: string;
  description: string;
  imageUrl: string;
  number: string;
}

const { title, description, imageUrl, number } = Astro.props;
---

<article class="feature-card">
    <button class="feature-image" type="button" data-image={imageUrl} data-caption={title} aria-label={`Ampliar imagen de ${title}`}>
        <img src={imageUrl} alt={title} loading="lazy" />
        <span aria-hidden="true">↗</span>
    </button>
    <div class="feature-content"><div class="feature-title"><span>{number} /</span><h3>{title}</h3></div><p>{description}</p></div>
</article>
