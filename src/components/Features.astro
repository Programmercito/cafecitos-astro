---
// src/components/Features.astro
import FeatureCard from './FeatureCard.astro';

const featuresData = [
  {
    title: "Registro de Productos",
    description: "Gestiona de forma intuitiva todo tu catálogo de productos. Asigna nombres, precios, categorías e imágenes para una visualización clara y una administración eficiente.",
    imageUrl: "/images/tres.png"
  },
  {
    title: "Gestión de Órdenes",
    description: "Registra, modifica y sigue cada orden en tiempo real. Identifica el tipo de producto, añade o elimina ítems fácilmente y calcula el total al instante, mejorando la experiencia del cliente y la eficiencia del servicio.",
    imageUrl: "/images/cuatro.png"
  },
  {
    title: "Máquina de Estados",
    description: "Controla el ciclo de vida de cada orden con estados claros: Abierta, Cerrada, Pagada, En Comisión o Procesada. Esto te permite una administración precisa y un seguimiento detallado del flujo de trabajo en tu negocio.",
    imageUrl: "/images/ocho.png"
  },
  {
    title: "Configuración Flexible",
    description: "Adapta el sistema a las particularidades de tu negocio. Define diferentes esquemas de pago de comisiones y personaliza cómo se administran los cobros y las comisiones con tu equipo de meseros.",
    imageUrl: "/images/diez.png"
  },
  {
    title: "Reportes de Ganancias",
    description: "Accede a informes detallados de tus ganancias y las comisiones generadas por tu personal. Visualiza los datos en pantalla o expórtalos a PDF para un análisis completo y una toma de decisiones informada.",
    imageUrl: "/images/doce.png"
  },
  {
    title: "Roles de Usuario",
    description: "Garantiza la seguridad y el control con tres roles de usuario predefinidos: Administrador, Encargado y Mesero. Cada rol tiene permisos específicos para optimizar las operaciones y proteger la información sensible.",
    imageUrl: "/images/uno.png"
  },
  {
    title: "Cálculo de Comisiones",
    description: "Automatiza el cálculo de comisiones para tu equipo, eliminando errores manuales y ahorrando tiempo valioso. Incentiva el rendimiento de tu personal con un sistema justo y transparente.",
    imageUrl: "/images/doce.png"
  }
];
---

<section id="features" class="features-section shell">
    <div class="section-heading">
        <div><p class="section-kicker">01 / HECHO PARA FLUIR</p><h2>Todo en su lugar.<br /><em>Como debe ser.</em></h2></div>
        <p>De la primera orden al último reporte: las herramientas que necesitas para enfocarte en lo que más importa.</p>
    </div>
    <div class="features-grid">
            {featuresData.map((feature, index) => (
                <FeatureCard
                    title={feature.title}
                    description={feature.description}
                    imageUrl={feature.imageUrl}
                    number={String(index + 1).padStart(2, '0')}
                />
            ))}
    </div>
</section>